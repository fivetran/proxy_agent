#!/usr/bin/env bash
#
#  Stub curl for tests/bash/manager.bats. Records its arguments to $CURL_LOG,
#  answers every call with $STUB_CURL_RESPONSE and never touches the network.
#
echo "$*" >> "$CURL_LOG"
while [ "$#" -gt 0 ]; do
    if [ "$1" = "-o" ]; then
        printf '%s' "$STUB_CURL_RESPONSE" > "$2"
        exit "${STUB_CURL_EXIT_CODE:-0}"
    fi
    shift
done
printf '%s\n' "$STUB_CURL_RESPONSE"
exit "${STUB_CURL_EXIT_CODE:-0}"
